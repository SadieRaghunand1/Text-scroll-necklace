<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="NecklaceContollerApp.Views.JustColorPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:docutain="clr-namespace:Docutain.ColorPicker.MAUI;assembly=Docutain.ColorPicker.MAUI"
    xmlns:views="clr-namespace:NecklaceContollerApp.Views"
    xmlns:models="clr-namespace:NecklaceContollerApp.Models"
    Title="ChooseColorPage"
    BackgroundColor="Lavender"
>

    <VerticalStackLayout>
        <Label
            x:Name="InstructionsBGColor"
            Text="Pick the background color for you keychain!"
            VerticalOptions="Start" 
            HorizontalOptions="Center"
            LineBreakMode="WordWrap"
            FontSize="16"
            TextColor="Black" 
            Padding="10"/>
        
        <Label
     x:Name="InstructionsTextColor"
     Text="Pick the text color for you keychain!"
     VerticalOptions="Start" 
     HorizontalOptions="Center"
     LineBreakMode="WordWrap"
     FontSize="16"
     TextColor="Black" 
     Padding="10"/>
        
    </VerticalStackLayout>


</ContentPage>