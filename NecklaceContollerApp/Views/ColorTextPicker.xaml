<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NecklaceContollerApp.Models"
             x:Class="NecklaceContollerApp.Views.ColorTextPicker"
             Title="ColorTextPicker"
             x:DataType="models:ColorPickerFunc">
    <ContentPage.BindingContext>
        <models:ColorPickerFunc />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label 
            x:Name="TitleText"
            Text="This is the color picker page"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button 
            x:Name="PickedColor" 
            Text="Hover to Click"
            Clicked="OnColorPicked"
          />
    </VerticalStackLayout>
</ContentPage>