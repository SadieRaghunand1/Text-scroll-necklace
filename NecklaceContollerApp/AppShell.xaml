<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NecklaceContollerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NecklaceContollerApp.Views"
    xmlns:models="clr-namespace:NecklaceContollerApp.Models"
    Shell.FlyoutBehavior="Disabled"
    Title="NecklaceContollerApp">

    <ShellContent>
        <ShellContent.BindingContext>
            <models:ColorPickerFunc />
        </ShellContent.BindingContext>
        <ContentPage>
            <VerticalStackLayout>
                <Label 
                    x:Name="TitleText"
                    Text="This is the color picker page"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />
                <Button 
                    x:Name="ChangeColor"
                    Text="Change background color"
                    Clicked="OnColorPicked"
                />
                <Button 
                    x:Name="ChangeText"
                    Text="Change text"
                    Clicked="OnTextPicked"
                />
                <Label x:Name="CurrentText" FontSize="48" TextColor="Black"/>
                <Label x:Name="CurrentBG" FontSize="48" TextColor="Black"/>
                <Label x:Name="CurrentTextColor" FontSize="48" TextColor="Black"/>
            </VerticalStackLayout>
        </ContentPage>
    </ShellContent>

</Shell>
